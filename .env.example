# Where the SQLite database lives (mount this as a volume in Docker)
DATA_DIR=./data
# Public URL; required for OIDC redirect URIs behind a reverse proxy
APP_URL=http://localhost:3000
# First account is always admin. Set false to close sign-ups after that.
ALLOW_SIGNUP=true
# DISABLE_PASSWORD_LOGIN=true

# OpenID Connect (Tinyauth, Authelia, Authentik, Pocket ID, Keycloak, Google...)
# Redirect URI to register with the provider: ${APP_URL}/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Tinyauth
# OIDC_AUTO_CREATE=false   # only allow SSO for emails that already have accounts
# OIDC_SKIP_2FA=true       # trust the provider's own 2FA

# Forward-auth (Tinyauth/Authelia proxy mode): header carrying the signed-in email
# TRUSTED_EMAIL_HEADER=Remote-Email
# TRUSTED_NAME_HEADER=Remote-Name

# Deal alerts: re-check each linked item's price every N hours (0 disables)
PRICE_CHECK_HOURS=24

# AI ideas can also be configured in Admin; these are fallbacks
# AI_PROVIDER=anthropic   # anthropic | openai | gemini | meta | local | none
# AI_MODEL=claude-opus-5-5
# AI_API_KEY=
# AI_BASE_URL=http://ollama:11434/v1
